+                const state: apprt.action.ProgramStatus.State = switch (report.state) {
+                    .idle => .idle,
+                    .working => .working,
+                    .done => .done,
+                    .blocked => .blocked,
+                    .@"error" => .@"error",
+                    .clear => .clear,
+                };
+
+                const kind: apprt.action.ProgramStatus.Kind = if (report.readOption(.kind)) |k| switch (k) {
+                    .permission => .permission,
+                    .question => .question,
+                    .auth => .auth,
+                } else .none;
+
+                const progress: i16 = if (report.readOption(.progress)) |p| @intCast(p) else -1;
+
+                const id_z = try alloc.dupeSentinel(u8, report.readOption(.id) orelse "", 0);
+                const app_z = try alloc.dupeSentinel(u8, report.readOption(.app) orelse "", 0);
+
+                var title_buf: [terminal.osc.program_status.max_title_bytes]u8 = undefined;
+                var title_w: std.Io.Writer = .fixed(&title_buf);
