+/// Returns the pid of the running child process, if one is running.
+/// This is best-effort: it returns null before the process starts and
+/// after it has been cleaned up. The value is written once by the IO
+/// thread during spawn and never mutated afterwards.
+pub fn childPid(self: *Exec) ?posix.pid_t {
+    const process = self.subprocess.process orelse return null;
+    switch (process) {
+        .fork_exec => |cmd| return cmd.pid,
+        .flatpak => return null,
+    }
+}
