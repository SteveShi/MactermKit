+                const title_z = try alloc.dupeSentinel(u8, title_w.buffered(), 0);
+
+                var msg_buf: [terminal.osc.program_status.max_msg_bytes]u8 = undefined;
+                var msg_w: std.Io.Writer = .fixed(&msg_buf);
+                try report.writeText(.msg, &msg_w);
+                const msg_z = try alloc.dupeSentinel(u8, msg_w.buffered(), 0);
+
+                req.* = .{
+                    .arena = arena,
+                    .report_c = .{
+                        .state = state,
+                        .kind = kind,
+                        .progress = progress,
+                        .id = id_z,
+                        .app = app_z,
