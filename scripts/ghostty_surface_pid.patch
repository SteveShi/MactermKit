+/// Same as `dumpTextLocked` but formats with VT (ANSI SGR escape sequences)
+/// so styled text, colors, and attributes are preserved.
+pub fn dumpTextVtLocked(
+    self: *Surface,
+    alloc: Allocator,
+    sel: terminal.Selection,
+) !Text {
+    const ScreenFormatter = terminal.formatter.ScreenFormatter;
+    var aw: std.Io.Writer.Allocating = .init(alloc);
+    defer aw.deinit();
+
+    var formatter: ScreenFormatter = .init(self.io.terminal.screens.active, .{
+        .emit = .vt,
+        .unwrap = true,
+        .trim = false,
+        .background = self.io.terminal.colors.background.get(),
+        .foreground = self.io.terminal.colors.foreground.get(),
+        .palette = &self.io.terminal.colors.palette.current,
+    });
+    formatter.content = .{ .selection = sel };
+    try formatter.format(&aw.writer);
+
+    const text = try aw.toOwnedSliceSentinel(0);
+    return .{
+        .text = text,
+        .viewport = null,
+    };
+}
